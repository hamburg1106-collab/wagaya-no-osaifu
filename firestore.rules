rules_version = '2';

// Firebaseコンソール（ouchi-no-kondate → Firestore → ルール）に貼るもの。
//
// このプロジェクトは複数のアプリで共用している。既存のアプリのコレクションを
// 消すと他のアプリが止まるので、貼る前にコンソール側の中身と見比べること。
//
// 「わが家のお財布」は合言葉方式をやめてGoogleログインに変えた。
// 家計の貯蓄残高と収入を扱うので、リンクを知っている人が全員読める方式は使えない。
// 夫婦2人ぶんのuidを書いて、その2人だけが読み書きできるようにする。
//
// ↓の 'UID_TOSHI' と 'UID_TSUMA' は本物のuidに置き換えること。
// 手順: 2人とも一度アプリでログイン →
//       Firebaseコンソール → Authentication → ユーザー → uidをコピー → ここに貼る。
// 本物は uid.local.txt（Git管理外）に控える。このファイルは公開リポジトリに載る。
service cloud.firestore {
  match /databases/{database}/documents {

    // わが家のお財布（家計簿・見通し）
    match /kakeibo/{household}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in ['UID_TOSHI', 'UID_TSUMA'];
    }

    // これ買っていい（資金管理）
    match /shikin/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // 献立提案アプリ
    match /inventory/{doc} { allow read, write: if true; }
    match /recipes/{doc}   { allow read, write: if true; }
    match /history/{doc}   { allow read, write: if true; }

    // これ食っていい
    match /daily/{doc}       { allow read, write: if true; }
    match /healthUsers/{doc=**} { allow read, write: if true; }
    match /meals/{doc}       { allow read, write: if true; }
    match /profile/{doc}     { allow read, write: if true; }
  }
}
