rules_version = '2';

// Firebaseコンソール（ouchi-no-kondate → Firestore → ルール）に貼るもの。
//
// このプロジェクトは4つのアプリで共用している。他のアプリの行を消すと
// そのアプリが止まるので、貼る前にコンソールの現行値と見比べること。
// 下の内容は 2026-09-23 にコンソールの現行値を確認して合わせたもの。
//
// 「わが家のお財布」は合言葉方式をやめてGoogleログインに変えた。
// 家計の貯蓄残高と収入を扱うので、リンクを知っている人が全員読める方式は使えない。
//
// ↓の 'UID_TOSHI' は本物のuidに置き換えること。
// 手順: アプリでログイン → 設定タブ →「IDをコピー」。
//       （Firebaseコンソール → Authentication → ユーザー でも見られる）
// 本物は uid.local.txt（Git管理外）に控える。このファイルは公開リポジトリに載る。
service cloud.firestore {
  match /databases/{database}/documents {

    // --- わが家のお財布（家計簿・見通し） ---
    // 妻を足すときは uid をカンマで続ける: in ['UID_TOSHI', 'UID_TSUMA']
    match /kakeibo/{household}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in ['UID_TOSHI'];
    }

    // --- これ買っていい（資金管理） ---
    match /shikin/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // --- うちの献立（今まで通り） ---
    match /inventory/{doc} { allow read, write: if true; }
    match /recipes/{doc}   { allow read, write: if true; }
    match /history/{doc}   { allow read, write: if true; }

    // --- これ食っていい？ ---
    // 同期コードを知っている端末だけが読み書きできる。
    // healthUsers の一覧は取れないので、コードを知らない人はデータに辿り着けない。
    match /healthUsers/{code}/{sub}/{doc} {
      allow read, write: if code.size() >= 16;
    }
  }
}
